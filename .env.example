# --- Required ---
# HubSpot Private App access token (server-side only — never sent to the browser).
# Create it in HubSpot: Settings -> Integrations -> Private Apps.
# Scopes needed (read-only): crm.objects.deals.read, crm.objects.owners.read,
# crm.schemas.deals.read (pipelines/stages ride along with deals access).
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Optional: week-over-week history ---
# Provision a Vercel KV (Upstash Redis) store from the Vercel dashboard
# (Storage -> Create Database -> KV) and connect it to this project.
# Vercel injects these two automatically once connected — you usually do NOT
# set them by hand. Listed here so it's clear what powers the "vs last week"
# lines. Without them, the dashboard still works; it just never shows WoW deltas.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional: who may embed this page ---
# Comma-free, edited directly in vercel.json (see README) rather than here,
# since Vercel's static header config can't read env vars at request time.
# Left as a placeholder / reminder only — not read by any code.
# ALLOWED_FRAME_ANCESTORS=https://*.hubspot.com
